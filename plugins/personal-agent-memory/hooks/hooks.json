{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/recall.mjs\"",
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/recall.mjs\""}
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/recall.mjs\"",
            "additionalContextLimit": 12000
          }
        ]
      }
    ]
  }
}
